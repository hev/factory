---
import { getEntry, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { DEFAULT_EDITION } from "../../lib/docs";

const entry = await getEntry("docs", "index");
if (!entry) {
	throw new Error("Missing docs index page");
}
const { Content, headings } = await render(entry);
---

<DocsLayout entry={entry} headings={headings} edition={DEFAULT_EDITION} legacy={true}>
	<Content />
</DocsLayout>
