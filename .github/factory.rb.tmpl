# Generated by .github/bump-tap.sh on every tagged release. Edits here are
# overwritten; change the template in hev/factory instead.
class Factory < Formula
  desc "Orchestrate a crew of coding agents on a Mac you own"
  homepage "https://hevfactory.com"
  license "Apache-2.0"

  # Sorted the way `brew audit` sorts them, which treats the macOS constraint as
  # one more name in the list. launchd, tmux and the login keychain are why it
  # is there: no Linux build exists to fall back to.
  depends_on "gh"
  depends_on "jq"
  depends_on :macos
  depends_on "tmux"

  # Not `on_arm`/`on_intel`. Those blocks install and run, but `brew audit`
  # rejects url and sha256 inside them, and a formula that only works until
  # somebody audits it is a formula with a fuse in it.
  if Hardware::CPU.arm?
    url "https://github.com/hev/factory/releases/download/v@@VERSION@@/factory_@@VERSION@@_darwin_arm64.tar.gz"
    sha256 "@@SHA_ARM64@@"
  else
    url "https://github.com/hev/factory/releases/download/v@@VERSION@@/factory_@@VERSION@@_darwin_amd64.tar.gz"
    sha256 "@@SHA_AMD64@@"
  end

  def install
    bin.install "factory"
  end

  def caveats
    <<~EOS
      Sessions run in yolo mode, as whoever the host is logged in as. Read the
      warning before the first run: https://github.com/hev/factory

      You still need `claude` (or `codex`) logged in, `gh`, and `tmux`.
      Homebrew cannot install the harnesses, and the factory never sees your
      API keys.

      Every host needs this same build. Add one with `factory hosts add ALIAS`,
      and run `factory skill install` so your laptop's Claude knows the tools.
    EOS
  end

  test do
    assert_match "factory", shell_output("#{bin}/factory --help")
  end
end
