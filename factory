#!/bin/bash
# factory — start the factory.
#
# One command, and the only one the quickstart needs. It installs reception as
# a user skill, boots any gaffer whose config names this machine as home, and
# opens the picker.
#
#   ./factory              every gaffer that belongs on this host
#   ./factory up           the same, lifts any hold a stop left behind, and
#                          reports which gaffers are ready
#   ./factory list         the factories configured here, and what is up
#   ./factory init ...     write one factory's config (./factory init --help)
#   ./factory cleanup ...  remove a factory and everything it left behind
#   ./factory stop ...     stop the gaffers and hold them down (workers stay)
#   ./factory --no-picker  same as bare, but stay at the shell (launchd, cron)
#
# Everything it calls is idempotent, so running it twice is a no-op and running
# it on a schedule is how a factory survives a reboot. A factory the operator
# stopped is held down and skipped, so the schedule cannot undo a stop.
#
# On a fresh clone, invoke /reception in any Claude session to configure one.

set -uo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PICKER="$ROOT_DIR/bin/picker"
OPEN_PICKER=1

# Keep the copy on PATH in step with this checkout. A globally installed
# `factory` that is older than the repo is the bug nobody thinks to look for:
# the command you typed and the code you are reading are different programs,
# and the symptom is a subcommand that exists in the source and not in your
# shell. Copying the binary we just built is exact, where `go install` would
# rebuild and could disagree.
#
# Set FACTORY_NO_GLOBAL_INSTALL=1 to keep this out of your PATH.
install_global() {
    [[ -z "${FACTORY_NO_GLOBAL_INSTALL:-}" ]] || return 0

    local bin_dir target
    bin_dir="$(go env GOBIN 2>/dev/null)"
    [[ -n "$bin_dir" ]] || bin_dir="$(go env GOPATH 2>/dev/null)/bin"
    [[ -d "$bin_dir" ]] || return 0

    target="$bin_dir/factory"
    cmp -s "$PICKER" "$target" && return 0

    # Written beside the target and moved into place, so a `factory` running
    # right now is never a half-written file.
    cp "$PICKER" "$target.new" && mv -f "$target.new" "$target" || {
        echo "factory: could not update $target" >&2
        return 0
    }
    echo "factory: updated $target"

    case ":$PATH:" in
        *":$bin_dir:"*) ;;
        *) echo "factory: $bin_dir is not on your PATH — add it to run \`factory\` from anywhere" ;;
    esac
}

# Built here rather than committed: a checked-in binary is an artefact nobody
# can review and the wrong one for half the machines that clone this. The build
# is skipped unless a source file is newer than the binary, so the usual run
# pays nothing for it — but the global copy is checked either way, because a
# stale one outlives the build that should have replaced it.
build_picker() {
    if [[ -x "$PICKER" ]] && \
       [[ -z "$(find "$ROOT_DIR/cmd" "$ROOT_DIR/internal" "$ROOT_DIR/pkg" -name '*.go' -newer "$PICKER" -print -quit 2>/dev/null)" ]]; then
        install_global
        return 0
    fi
    echo "factory: building the picker"
    (cd "$ROOT_DIR" && go build -o bin/picker ./cmd/factory) || return 1
    install_global
}

# Anything that is not a boot flag is a subcommand, and it goes straight to the
# picker binary: list, init, cleanup, stop. They are handled before
# anything boots, because none of them should need a running factory and half
# of them exist for the times when the running factory is the problem. Passing
# the arguments through unread also means this script never has to be edited
# again when the binary grows one.
case "${1:-}" in
    ""|--no-picker|-h|--help) ;;
    up)
        # `up` is the boot, and the boot is this script. The binary's version
        # of `up` lifts the holds and then execs right back here, so taking it
        # in the passthrough below would be a loop.
        command -v go &>/dev/null || { echo "missing: go" >&2; exit 1; }
        build_picker || { echo "factory: could not build the picker" >&2; exit 1; }
        exec "$PICKER" up "${@:2}"
        ;;
    *)
        command -v go &>/dev/null || { echo "missing: go" >&2; exit 1; }
        build_picker || { echo "factory: could not build the picker" >&2; exit 1; }
        exec "$PICKER" "$@"
        ;;
esac

for arg in "$@"; do
    case "$arg" in
        --no-picker) OPEN_PICKER=0 ;;
        -h|--help)   sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)           echo "unknown argument: $arg" >&2; exit 2 ;;
    esac
done

# Hard dependencies. The picker is a Go binary built from source below; the
# gaffers need gh to open pull requests and jq to read the child ledger.
missing=()
for cmd in tmux go gh jq; do
    command -v "$cmd" &>/dev/null || missing+=("$cmd")
done
if [[ ${#missing[@]} -gt 0 ]]; then
    echo "missing: ${missing[*]}" >&2
    echo "run: brew install ${missing[*]}" >&2
    exit 1
fi

# 0. Record which checkout this is. A globally installed front door
#    (`go install github.com/hev/factory/cmd/factory@latest`) lives in ~/golang/bin with
#    no repo above it, so it cannot find factories/*.toml by looking around
#    itself. This is how it is told, and rewriting it every run means moving
#    the checkout fixes itself on the next boot.
mkdir -p "$HOME/.factory"
printf '%s\n' "$ROOT_DIR" > "$HOME/.factory/root"

# 1. Reception is a user-level skill, not a process. The installed file is a
#    stable wrapper; it resolves this checkout through ~/.factory/root each
#    time, so the charter remains the one source of truth.
install_reception_skill() {
    local source="$ROOT_DIR/.claude/skills/reception/SKILL.md"
    local target="$HOME/.claude/skills/reception/SKILL.md"
    local init_source="$ROOT_DIR/.claude/skills/init-factory/SKILL.md"
    local init_target="$HOME/.claude/skills/init-factory/SKILL.md"
    [[ -f "$source" ]] || { echo "factory: missing reception skill wrapper" >&2; return 1; }
    mkdir -p "$(dirname "$target")" || return 1
    cmp -s "$source" "$target" || cp "$source" "$target"
    mkdir -p "$(dirname "$init_target")" || return 1
    cmp -s "$init_source" "$init_target" || cp "$init_source" "$init_target"
}
install_reception_skill || { echo "factory: could not install reception skill" >&2; exit 1; }

# 2. Gaffers, each on the runtime its config asks for:
#      resident  factory-up.sh keeps a claude session alive in tmux
#      one-shot  factory-iterate.sh runs one iteration and exits
#      anything else  runtimes/<name>.sh, which is where a runtime this build
#                     does not ship gets plugged in (contracts/extending.md)
#    Both built-ins exit 78 on a machine that isn't the config's home_host,
#    which is how a laptop with a stale clone stays quiet — so 78 is expected,
#    not an error.
runtime_of() {
    local value
    value="$(awk -F= '
        $1 ~ /^[[:space:]]*runtime[[:space:]]*$/ {
            v=$2; sub(/^[[:space:]]*/,"",v); sub(/[[:space:]]*#.*/,"",v)
            sub(/[[:space:]]*$/,"",v); gsub(/^"|"$/,"",v); print v; exit
        }' "$1")"
    printf '%s\n' "${value:-resident}"
}

runner_for() {
    case "$1" in
        resident) printf '%s\n' "$ROOT_DIR/factory-up.sh" ;;
        one-shot) printf '%s\n' "$ROOT_DIR/factory-iterate.sh" ;;
        *)        printf '%s\n' "$ROOT_DIR/runtimes/$1.sh" ;;
    esac
}

shopt -s nullglob
for config in "$ROOT_DIR"/factories/*.toml; do
    instance="$(basename "$config" .toml)"
    [[ "$instance" == "example" ]] && continue

    # A hold is an operator's stop that outlives the timer. `factory up` is
    # the only thing that lifts one, so this fire leaves the factory alone —
    # which is the whole reason a stopped gaffer no longer reappears five
    # minutes later (pkg/factory/holds.go).
    if [[ -e "${FACTORY_HOLDS_DIR:-$HOME/.factory/holds}/$instance" ]]; then
        # Said on every fire, including under launchd. One line per held
        # factory per 300s is cheap; a gaffer that silently never starts is
        # the bug this whole mechanism was built to stop being mysterious.
        echo "factory: '$instance' is held — run: factory up $instance"
        continue
    fi

    runtime="$(runtime_of "$config")"
    runner="$(runner_for "$runtime")"
    if [[ ! -x "$runner" ]]; then
        echo "factory: '$instance' asks for runtime \"$runtime\", which this build does not ship" >&2
        echo "factory: see contracts/extending.md — a runtime is runtimes/$runtime.sh" >&2
        continue
    fi

    "$runner" "$instance"
    status=$?

    if [[ $status -ne 0 && $status -ne 78 ]]; then
        echo "factory: gaffer '$instance' failed (exit $status)" >&2
    fi

    "$ROOT_DIR/scripts/floor-watch.sh" "$instance" || \
        echo "factory: floor watcher for '$instance' failed" >&2
done
shopt -u nullglob

# 3. The screen you actually sit in. Nothing above attached to anything, so
#    this is where it gets chosen. Always the local build: a checkout you are
#    editing should never be shadowed by a stale install.
[[ "$OPEN_PICKER" -eq 1 ]] || exit 0

build_picker || { echo "factory: could not build the picker" >&2; exit 1; }
exec "$PICKER"
